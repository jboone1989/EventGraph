# Development: non-secret feature flags. Merge explicitly into private .env on dev host.
AIHOT_ENVIRONMENT=development
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true
NVIDIA_MODEL_POOL_ENABLED=true
NVIDIA_MODEL_DISCOVERY_PROBES_ENABLED=true
NVIDIA_POOL_ROUTE_DEFAULT=true
GRAPHITI_INGEST_ENABLED=true
ADSENSE_VERIFICATION_ENABLED=false

# Switch after DB migration and independent model checks; legacy pool unchanged until enabled.
MODEL_PROVIDER_REGISTRY_ENABLED=false

# VM13 preview only: set by docker-compose.vm13-preview.yml for read-only production-backed sessions.
# Do not enable this for the normal cn-dev application or production migrations.
# EVENTGRAPH_PREVIEW_READONLY=true
